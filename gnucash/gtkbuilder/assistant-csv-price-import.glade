                                </child>
                                <child>
                                  <object class="GtkLabel" id="label18">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">Trailing Lines to Skip</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">5</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="hbox2">
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">4</property>
                                    </layout>
                                    <child>
                                      <object class="GtkSpinButton" id="start_row">
                                        <property name="halign">center</property>
                                        <property name="focusable">1</property>
                                        <property name="adjustment">start_row_adj</property>
                                        <property name="numeric">1</property>
                                        <signal name="value-changed" handler="csv_price_imp_preview_srow_cb" swapped="no" />
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="hbox3">
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">5</property>
                                    </layout>
                                    <child>
                                      <object class="GtkSpinButton" id="end_row">
                                        <property name="halign">center</property>
                                        <property name="focusable">1</property>
                                        <property name="adjustment">end_row_adj</property>
                                        <property name="numeric">1</property>
                                        <signal name="value-changed" handler="csv_price_imp_preview_erow_cb" swapped="no" />
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator" id="hseparator2">
                                    <property name="margin-start">3</property>
                                    <property name="margin-end">3</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">3</property>
                                      <property name="column-span">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="skip_rows_label">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">Skip alternate lines</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">6</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="skip_rows">
                                    <property name="focusable">1</property>
                                    <property name="tooltip-text" translatable="1">Starting from the first line that is actually imported every second line will be skipped. This option will take the leading lines to skip into account as well.
For example
* if "Leading Lines to Skip" is set to 3, the first line to import will be line 4. Lines 5, 7, 9,… will be skipped.
* if "Leading Lines to Skip" is set to 4, the first line to import will be line 5. Lines 6, 8, 10,… will be skipped.</property>
                                    <property name="halign">start</property>
                                    <signal name="toggled" handler="csv_price_imp_preview_skiprows_cb" swapped="no" />
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">6</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="date_format_container">
                                    <property name="hexpand">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="currency_format_container">
                                    <property name="hexpand">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="encoding_container">
                                    <property name="hexpand">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <child type="label">
                              <object class="GtkLabel" id="label13">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Miscellaneous</property>
                                <style>
                                  <class name="gnc-class-strong" />
                                </style>
                                <property name="use-markup">1</property>
                              </object>
                            </child>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox1">
                        <property name="valign">center</property>
                        <property name="halign">start</property>
                        <property name="margin-bottom">6</property>
                        <child>
                          <object class="GtkFrame" id="frame1">
                            <property name="halign">center</property>
                            <property name="child">
                              <object class="GtkBox" id="commodity_hbox"></object>
                            </property>
                            <child type="label">
                              <object class="GtkLabel" id="label1">
                                <property name="label" translatable="1">Commodity From</property>
                                <style>
                                  <class name="gnc-class-strong" />
                                </style>
                                <property name="use-markup">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkFrame" id="frame3">
                            <property name="halign">center</property>
                            <property name="child">
                              <object class="GtkBox" id="currency_hbox"></object>
                            </property>
                            <child type="label">
                              <object class="GtkLabel" id="label8">
                                <property name="label" translatable="1">Currency To</property>
                                <style>
                                  <class name="gnc-class-strong" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="preview_column_selectors">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">6</property>
                        <property name="hexpand">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow2">
                        <property name="vexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkBox" id="preview_placeholder" />
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox13">
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkImage" id="instructions_image">
                            <property name="icon-name">dialog-information</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="instructions_label">
                            <property name="hexpand">1</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Select the type of each column to import.</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCenterBox" id="hbox14">
                        <property name="valign">center</property>
                        <property name="end-widget">
                          <object class="GtkBox">
                            <child>
                              <object class="GtkCheckButton" id="skip_errors_button">
                                <property name="halign">center</property>
                                <property name="visible">0</property>
                                <property name="label" translatable="1">Skip Errors</property>
                                <property name="focusable">1</property>
                                <signal name="toggled" handler="csv_price_imp_preview_skiperrors_cb" swapped="no" />
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">page-3</property>
                <property name="title" translatable="1">Import Prices Now</property>
                <property name="child">
                  <object class="GtkBox" id="confirm_page">
                    <property name="valign">center</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="finish_label">
                        <property name="label" translatable="1">Press "Apply" to add the Prices.
"Cancel" to abort.</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">page-4</property>
                <property name="title" translatable="1">Import Summary</property>
                <property name="child">
                  <object class="GtkBox" id="summary_page">
                    <property name="valign">center</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="summary_label">
                        <property name="vexpand">1</property>
                        <property name="label">label</property>
                        <property name="use-markup">1</property>
                        <property name="wrap">1</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="gnc_import_assistant_actions">
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="gnc_import_assistant_cancel">
                <property name="label">_Cancel</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="gnc_import_assistant_back">
                <property name="label">_Back</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="gnc_import_assistant_next">
                <property name="label">_Next</property>
                <property name="use-underline">True</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="gnc_import_assistant_apply">
                <property name="label">_Apply</property>
                <property name="use-underline">True</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="gnc_import_assistant_close">
                <property name="label">_Close</property>
                <property name="use-underline">True</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>