  xmlns:vendor="http://www.gnucash.org/XML/vendor">

<gnc-act:title>
  Superannuation
</gnc-act:title>
<gnc-act:short-description>
  Superannuation account with related investment subaccounts
</gnc-act:short-description>
<gnc-act:long-description>
  You would want to select this set of accounts if you track your superannuation, such as a self-managed super fund (shares, bonds, managed funds, index funds).
</gnc-act:long-description>

<gnc:account version="2.0.0">
  <act:name>Root Account</act:name>
  <act:id type="new">1972cce2e2364f95b2b0bc014502661d</act:id>
  <act:type>ROOT</act:type>
  <act:commodity-scu>0</act:commodity-scu>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Assets</act:name>
  <act:id type="new">2a84a62540c25668bef3b7d2e46fcdcb</act:id>
  <act:type>ASSET</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Assets</act:description>
  <act:parent type="new">1972cce2e2364f95b2b0bc014502661d</act:parent>
  <act:slots>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Investments</act:name>
  <act:id type="new">8d0a742fccfb5b80b7864fdd536ebb05</act:id>
  <act:type>ASSET</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Investments</act:description>
  <act:parent type="new">2a84a62540c25668bef3b7d2e46fcdcb</act:parent>
  <act:slots>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Superannuation</act:name>
  <act:id type="new">45fd5bab843b5a4a80e62b16168bfe32</act:id>
  <act:type>BANK</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Superannuation</act:description>
  <act:parent type="new">8d0a742fccfb5b80b7864fdd536ebb05</act:parent>
  <act:slots>
    <slot>
      <slot:key>notes</slot:key>
      <slot:value type="string">Industry, retail or self-managed super fund</slot:value>
    </slot>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
