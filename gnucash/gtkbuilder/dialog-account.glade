            <property name="column-spacing">6</property>
            <child>
              <object class="GtkBox">
                <property name="halign">start</property>
                <property name="spacing">3</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
                <child>
                  <object class="GtkCheckButton" id="enable_cascade_color">
                    <property name="label" translatable="1">Enable Cascading Account Color</property>
                    <property name="focusable">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">3</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">4</property>
                </layout>
                <child>
                  <object class="GtkCheckButton" id="enable_cascade_placeholder">
                    <property name="label" translatable="1">Enable Cascading Account Placeholder</property>
                    <property name="focusable">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">3</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">7</property>
                </layout>
                <child>
                  <object class="GtkCheckButton" id="enable_cascade_hidden">
                    <property name="label" translatable="1">Enable Cascading Account Hidden</property>
                    <property name="focusable">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Enable the sections to Cascade</property>
                <attributes>
                  <attribute name="underline" value="True"></attribute>
                </attributes>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="color_box">
                <property name="sensitive">0</property>
                <property name="orientation">vertical</property>
                <property name="spacing">3</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
                <child>
                  <object class="GtkLabel" id="color_label">
                    <property name="wrap">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="color_button_box">
