  <object class="GtkWindow" id="aqbanking_transaction_dialog">
<property name="title" translatable="1">Online Transaction</property>
    <property name="destroy-with-parent">True</property>
<child>
      <object class="GtkBox" id="dialog-vbox7">
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="trans_vbox">
            <property name="vexpand">1</property>
<property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="heading_label">
                <property name="valign">center</property>
                <property name="label" translatable="1">Enter an Online Transaction</property>
                <property name="justify">center</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid">
