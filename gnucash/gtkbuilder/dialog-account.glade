<interface>
  <requires lib="gtk" version="4.10" />
  <object class="GtkWindow" id="account_cascade_dialog">
    <property name="title" translatable="1">Cascade Account Values</property>
    <child>
      <object class="GtkBox" id="account_cascade_dialog_content">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
<child>
      <object class="GtkBox">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
