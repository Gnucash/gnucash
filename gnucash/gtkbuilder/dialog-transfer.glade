<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="transfer_dialog">
<property name="title" translatable="1">Transfer Funds</property>
    <child>
      <object class="GtkBox" id="transfer_dialog_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="vbox">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="transfermain-vbox">
<property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkGrid" id="table">
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="transferinfo-label">
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Basic Information</property>
                    <style>
                      <class name="gnc-class-strong" />
                    </style>
                    <property name="use-markup">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="table1">
                    <property name="hexpand">1</property>
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label1">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Amount</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="amount_hbox">
                        <property name="hexpand">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label2">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Date</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="date_hbox">
                        <property name="hexpand">1</property>
                        <property name="spacing">3</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label3">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Num</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="num_entry">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="activates-default">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label4">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Description</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="description_entry">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="activates-default">1</property>
                        <signal name="insert-text" handler="gnc_xfer_description_insert_cb" swapped="no" />
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label5">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Memo</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="memo_entry">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="activates-default">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label13">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Notes</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="notes_entry">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="activates-default">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="table2">
                <property name="vexpand">1</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="left_trans_label">
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Transfer From</property>
                    <style>
                      <class name="gnc-class-strong" />
                    </style>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox">
                    <property name="hexpand">1</property>
                    <property name="spacing">12</property>
                    <style>
                      <class name="frame" />
                    </style>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                    <child>
                      <placeholder />
                    </child>
                    <child>
                      <object class="GtkLabel" id="left_currency_label">
                        <property name="margin-start">6</property>
                        <property name="margin-end">3</property>
                        <property name="margin-top">3</property>
                        <property name="margin-bottom">3</property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label8">
                    <property name="label">    </property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="right_trans_label">
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Transfer To</property>
                    <style>
                      <class name="gnc-class-strong" />
                    </style>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">0</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox1">
                    <property name="hexpand">1</property>
                    <property name="spacing">12</property>
                    <style>
                      <class name="frame" />
                    </style>
                    <layout>
                      <property name="column">3</property>
                      <property name="row">2</property>
                    </layout>
                    <child>
                      <placeholder />
                    </child>
                    <child>
                      <object class="GtkLabel" id="right_currency_label">
                        <property name="margin-start">6</property>
                        <property name="margin-end">3</property>
                        <property name="margin-top">3</property>
                        <property name="margin-bottom">3</property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="left_trans_window">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
<child>
                      <placeholder />
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="right_trans_window">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
<child>
                      <placeholder />
                    </child>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">1</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label7">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Currency</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label10">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Currency</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="left_show_button">
                    <property name="label" translatable="1">Show Income/Expense</property>
                    <property name="focusable">1</property>
                    <property name="halign">center</property>
                    <property name="use-underline">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">3</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="right_show_button">
                    <property name="label" translatable="1">Show Income/Expense</property>
                    <property name="focusable">1</property>
                    <property name="halign">center</property>
                    <property name="use-underline">1</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">3</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="curr_transfer_table">
                <property name="halign">center</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label11">
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Currency Transfer</property>
                    <style>
                      <class name="gnc-class-strong" />
                    </style>
                    <property name="use-markup">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label12">
                    <property name="label">    </property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="table3">
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkCheckButton" id="price_radio">
                        <property name="label" translatable="1">Exchange Rate</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="price_hbox">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="conv_forward">
                        <property name="justify">center</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="amount_radio">
                        <property name="label" translatable="1">To Amount</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <property name="group">price_radio</property>
                        <signal name="toggled" handler="price_amount_radio_toggled_cb" swapped="no" />
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="right_amount_hbox">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="conv_reverse">
                        <property name="justify">center</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="fetch">
                        <property name="label" translatable="1">_Fetch Rate</property>
                        <property name="focusable">1</property>
<property name="use-underline">1</property>
                        <signal name="clicked" handler="gnc_xfer_dialog_fetch" swapped="no" />
                        <layout>
                          <property name="column">3</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <placeholder />
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbbox">
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="1">_Cancel</property>
                <property name="focusable">1</property>
                <property name="use-underline">1</property>
              </object>

        </child>
        <child>
          <object class="GtkButton" id="ok_button">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
