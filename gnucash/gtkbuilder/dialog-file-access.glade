<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="file_access_dialog">
    <property name="default-width">600</property>
    <property name="default-height">500</property>
    <child>
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="halign">center</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="uri_type_label">
                <property name="label" translatable="1">Data Format</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
                <property name="use-markup">1</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vb_uri_type_container">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="readonly_checkbutton">
                <property name="hexpand">1</property>
                <property name="label" translatable="1">Open _Read-Only</property>
                <property name="focusable">1</property>
                <property name="halign">start</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="frame_file">
            <property name="vexpand">1</property>
<property name="child">
              <object class="GtkBox" id="file_chooser">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="margin-top">6</property>
                <child>
                  <object class="GtkButton" id="file_select_button">
                    <property name="label" translatable="1">_Choose File…</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="file_name_label">
                    <property name="label" translatable="1">No file selected</property>
                    <property name="ellipsize">middle</property>
                    <property name="hexpand">1</property>
                    <property name="halign">start</property>
                    <property name="selectable">1</property>
                  </object>
                </child>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label5">
                <property name="label" translatable="1">File</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
                <property name="use-markup">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="frame_database">
            <property name="valign">center</property>
            <property name="halign">center</property>
<property name="child">
              <object class="GtkGrid">
<property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label2">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Host</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label3">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Database</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label4">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Username</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label6">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Password</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">4</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tf_password">
                    <property name="focusable">1</property>
                    <property name="visibility">0</property>
<property name="activates-default">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">4</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tf_username">
                    <property name="focusable">1</property>
<property name="activates-default">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tf_database">
                    <property name="focusable">1</property>
<property name="activates-default">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tf_host">
                    <property name="focusable">1</property>
<property name="activates-default">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label7">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Port</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tf_port">
                    <property name="focusable">1</property>
                    <property name="activates-default">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label1">
                <property name="label" translatable="1">Database Connection</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
                <property name="use-markup">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="spacing">6</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="pb_op">
            <property name="label" translatable="1">_Save As</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
