  <object class="GtkBox" id="mainwin-toolbar">
    <property name="css-classes">toolbar</property>
    <child>
      <object class="GtkButton" id="but1">

        <property name="action-name">gnc-plugin-basic-commands-actions.FileSaveAction</property>
        <property name="tooltip-text" translatable="1">Save the current file</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-save</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Save</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but2">

        <property name="action-name">GncPluginPageInvoiceActions.FilePrintAction</property>
        <property name="tooltip-text" translatable="1">Make a printable invoice</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-print</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Print Invoice</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but3">

        <property name="action-name">mainwin.FileCloseAction</property>
        <property name="tooltip-text" translatable="1">Close the currently active page</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">window-close</property>
                <property name="pixel-size">24</property>
