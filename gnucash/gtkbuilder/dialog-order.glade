<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkTextBuffer" id="notes_buffer" />
  <object class="GtkWindow" id="order_entry_dialog">
    <property name="title" translatable="1">Order Entry</property>
    <property name="default-width">950</property>
<signal name="destroy" handler="gnc_order_window_destroy_cb" swapped="no" />
    <child>
      <object class="GtkBox" id="order_window_root">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">8</property>
        <property name="margin-bottom">8</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <child>
      <object class="GtkBox" id="dialog-vbox4">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="valign">center</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="valign">center</property>
                <child>
                  <object class="GtkFrame" id="frame1">
                    <property name="child">
                      <object class="GtkGrid">
<property name="row-spacing">3</property>
                        <property name="column-spacing">6</property>
                        <child>
                          <object class="GtkLabel" id="label1">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Order ID</property>
                            <property name="justify">right</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label3">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Date Opened</property>
                            <property name="justify">right</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="cd_label">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Date Closed</property>
                            <property name="justify">right</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="id_entry">
                            <property name="focusable">1</property>
                            <property name="editable">0</property>
<property name="activates-default">1</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="opened_date_hbox">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="closed_date_hbox">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="active_check">
                            <property name="focusable">1</property>
                            <property name="halign">start</property>
                            <property name="use-underline">1</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Active</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="label">
                      <object class="GtkLabel" id="label2">
                        <property name="label" translatable="1">Order Information</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame" id="frame3">
<property name="child">
                      <object class="GtkGrid">
<property name="row-spacing">3</property>
                        <property name="column-spacing">6</property>
                        <child>
                          <object class="GtkLabel" id="owner_label">
                            <property name="halign">end</property>
                            <property name="label">(owner)</property>
                            <property name="justify">right</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label7">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Reference</property>
                            <property name="justify">center</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="owner_hbox">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="ref_entry">
                            <property name="focusable">1</property>
<layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="label">
                      <object class="GtkLabel" id="label9">
                        <property name="label" translatable="1">Billing Information</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame" id="frame2">
                    <property name="hexpand">1</property>
<property name="child">
                      <object class="GtkScrolledWindow" id="scrolledwindow1">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="hscrollbar-policy">never</property>
<property name="child">
                          <object class="GtkTextView" id="notes_text">
                            <property name="focusable">1</property>
                            <property name="margin-start">3</property>
                            <property name="margin-end">3</property>
                            <property name="wrap-mode">word</property>
                            <property name="buffer">notes_buffer</property>
                            <property name="accepts-tab">0</property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <child type="label">
                      <object class="GtkLabel" id="label13">
                        <property name="label" translatable="1">Notes</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="ledger_frame">
                <property name="vexpand">1</property>
                <property name="child">
                  <object class="GtkBox" id="ledger_vbox">
<property name="orientation">vertical</property>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel" id="label14">
                    <property name="label" translatable="1">Order Entries</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
        </child>
        <child>
          <object class="GtkBox" id="order_actions">
            <property name="orientation">horizontal</property>
            <property name="hexpand">1</property>
            <property name="spacing">6</property>
        <child>
          <object class="GtkButton" id="helpbutton">
            <property name="hexpand">1</property>
            <property name="halign">start</property>
            <property name="label" translatable="1">_Help</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_help_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="closebutton">
            <property name="label" translatable="1">_Close</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_ok_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="new_invoice_button">
            <property name="label" translatable="1">_Invoices</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_invoice_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="close_order_button">
            <property name="label" translatable="1">Close _Order</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_close_order_cb" swapped="no" />
          </object>

        </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkTextBuffer" id="text_buffer" />
  <object class="GtkWindow" id="new_order_dialog">
    <property name="title" translatable="1">New Order</property>
<signal name="destroy" handler="gnc_order_window_destroy_cb" swapped="no" />
    <child>
      <object class="GtkBox" id="new_order_window_root">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">8</property>
        <property name="margin-bottom">8</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <child>
      <object class="GtkBox" id="dialog-vbox6">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="vbox10">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkFrame" id="frame4">
                <property name="vexpand">1</property>
<property name="child">
                  <object class="GtkGrid">
<property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label4">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Order ID</property>
                        <property name="justify">right</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_id">
                        <property name="focusable">1</property>
                        <property name="has-tooltip">1</property>
                        <property name="tooltip-markup">The order ID number. If left blank a reasonable number will be chosen for you</property>
                        <property name="tooltip-text" translatable="1">The order ID number. If left blank a reasonable number will be chosen for you</property>
                        <property name="hexpand">1</property>
<property name="activates-default">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label5">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Date Opened</property>
                        <property name="justify">right</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="date_opened_hbox">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel" id="label15">
                    <property name="label" translatable="1">Order Information</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="frame5">
                <property name="vexpand">1</property>
<property name="child">
                  <object class="GtkGrid">
<property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="bill_owner_label">
                        <property name="halign">end</property>
                        <property name="label">(owner)</property>
                        <property name="justify">right</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="bill_owner_hbox">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label16">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Reference</property>
                        <property name="justify">right</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_ref">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="editable">0</property>
<layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel" id="label6">
                    <property name="label" translatable="1">Billing Information</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="frame6">
                <property name="vexpand">1</property>
<property name="child">
                  <object class="GtkScrolledWindow" id="scrolledwindow2">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
<property name="hscrollbar-policy">never</property>
<property name="child">
                      <object class="GtkTextView" id="text_notes">
                        <property name="focusable">1</property>
                        <property name="margin-start">3</property>
                        <property name="margin-end">3</property>
                        <property name="editable">0</property>
                        <property name="wrap-mode">word</property>
                        <property name="buffer">text_buffer</property>
                        <property name="accepts-tab">0</property>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel" id="label17">
                    <property name="label" translatable="1">Notes</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
        </child>
        <child>
          <object class="GtkBox" id="new_order_actions">
            <property name="orientation">horizontal</property>
            <property name="hexpand">1</property>
            <property name="spacing">6</property>
        <child>
          <object class="GtkButton" id="help_button">
            <property name="hexpand">1</property>
            <property name="halign">start</property>
            <property name="label" translatable="1">_Help</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_help_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_cancel_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="ok_button">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_order_window_ok_cb" swapped="no" />
          </object>

        </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
