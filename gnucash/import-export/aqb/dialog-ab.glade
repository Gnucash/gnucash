        <child>
          <object class="GtkBox" id="vbox167">
            <property name="vexpand">1</property>
<property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkLabel" id="heading_pw_label">
                <property name="valign">center</property>
                <property name="label" translatable="1">Enter your password</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="flicker_hbox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Bar_width</property>
                    <property name="use-underline">1</property>
                    <property name="mnemonic-widget">spin_barwidth</property>
                    <attributes>
                      <attribute name="gravity" value="west"></attribute>
                    </attributes>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_barwidth">
                    <property name="focusable">1</property>
                    <property name="tooltip-text" translatable="1" comments="TAN generator with flicker interface common in DE only">Setting the bar width, adapting to the size of the TAN generator.</property>
                    <property name="numeric">1</property>
                    <property name="update-policy">if-valid</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Delay</property>
                    <property name="use-underline">1</property>
                    <property name="mnemonic-widget">spin_delay</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_delay">
                    <property name="focusable">1</property>
                    <property name="tooltip-text" translatable="1" comments="TAN generator with flicker interface common in DE only">Setting the delay time, with small values the flicker graphic is repeated faster.</property>
                    <property name="numeric">1</property>
                    <property name="update-policy">if-valid</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkDrawingArea" id="flicker_marker">
<property name="hexpand">1</property>
                <property name="vexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkImage" id="optical_challenge">
                    <property name="name">optical_challenge</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <property name="icon-name">image-missing</property>
</object>
                </child>
                <child>
                  <object class="GtkDrawingArea" id="flicker_challenge">
<property name="tooltip-text" translatable="1" comments="TAN generator with flicker interface common in DE only">Hold the TAN generator in front of the animated graphic. The markings (triangles) on the graphic must match those on the TAN generator.</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid1">
                <property name="halign">start</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label8877456">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Password</property>
                    <property name="use-underline">1</property>
                    <property name="mnemonic-widget">input_entry</property>
                    <property name="xalign">0</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="confirm_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Con_firm Password</property>
                    <property name="use-underline">1</property>
                    <property name="mnemonic-widget">confirm_entry</property>
                    <property name="xalign">0</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="input_entry">
                    <property name="focusable">1</property>
                    <property name="visibility">0</property>
                    <property name="invisible-char">●</property>
                    <property name="primary-icon-activatable">0</property>
                    <property name="secondary-icon-activatable">0</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="confirm_entry">
                    <property name="focusable">1</property>
                    <property name="visibility">0</property>
                    <property name="invisible-char">●</property>
                    <property name="primary-icon-activatable">0</property>
                    <property name="secondary-icon-activatable">0</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="remember_pin">
                    <property name="label" translatable="1">_Remember the PIN in memory</property>
                    <property name="focusable">1</property>
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-markup">If active, the PIN for HBCI/AqBanking actions will be remembered in memory during a session. Otherwise it will have to be entered again each time during a session when it is needed.</property>
                    <property name="tooltip-text" translatable="1">If active, the PIN for FinTS/AqBanking actions will be remembered in memory during a session. Otherwise it will have to be entered again each time during a session when it is needed.</property>
                    <property name="halign">center</property>
                    <property name="use-underline">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
