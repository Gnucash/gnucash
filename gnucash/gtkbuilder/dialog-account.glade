                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="sub_label">
                    <property name="label" translatable="1">If any account has an existing color it will not be replaced unless the following is ticked.</property>
                    <property name="wrap">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="replace_check">
                    <property name="label" translatable="1">Replace any existing account colors</property>
                    <property name="focusable">1</property>
                    <property name="halign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="placeholder_box">
                <property name="sensitive">0</property>
                <property name="orientation">vertical</property>
                <property name="spacing">3</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">5</property>
                </layout>
                <child>
