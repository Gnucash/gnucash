<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="xml_encoding_window">
    <property name="default-width">560</property>
    <property name="default-height">420</property>
    <property name="title" translatable="1">Ambiguous character encoding</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkLabel" id="message_label">
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style><class name="error"/></style>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="xml_encoding_stack">
            <property name="vexpand">True</property>
            <property name="transition-type">slide-left-right</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">start</property>
                <property name="title" translatable="1">Ambiguous character encoding</property>
                <property name="child">
                  <object class="GtkBox" id="start_page">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel" id="start_page_label">
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">conversion</property>
                <property name="title" translatable="1">Convert the file</property>
                <property name="child">
                  <object class="GtkBox" id="conversion_page">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkBox" id="default_enc_box">
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="1">Default encoding</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="edit_encs_button">
                        <property name="label" translatable="1">_Edit list of encodings</property>
                        <property name="use-underline">True</property>
                        <property name="halign">start</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="impossible_label">
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                        <style><class name="error"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">True</property>
                        <property name="child">
                          <object class="GtkBox" id="string_box_container">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">finish</property>
                <property name="title" translatable="1">Finish GnuCash Datafile Import</property>
                <property name="child">
                  <object class="GtkBox" id="end_page">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel" id="end_page_label">
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="assistant_cancel">
                <property name="label" translatable="1">_Cancel</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="assistant_back">
                <property name="label" translatable="1">_Back</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="assistant_next">
                <property name="label" translatable="1">_Next</property>
                <property name="use-underline">True</property>
                <property name="receives-default">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
