<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="reconcile_start_dialog">
    <property name="resizable">0</property>
    <property name="child">
      <object class="GtkBox" id="dialog-vbox6">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="valign">center</property>
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="label1">
                <property name="valign">center</property>
                <property name="halign">start</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="label" translatable="1">Reconcile Information</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
                <property name="use-markup">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="table1">
<property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="date_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Statement _Date</property>
                    <property name="use-underline">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="start_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Starting Balance</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="end_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Ending Balance</property>
                    <property name="use-underline">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="subaccount_check">
                    <property name="label" translatable="1">Include _subaccounts</property>
                    <property name="focusable">1</property>
                    <property name="tooltip-text" translatable="1">Include all descendant accounts in the reconcile. All of them must use the same commodity as this one.</property>
                    <property name="use-underline">1</property>
                    <signal name="toggled" handler="gnc_start_recn_children_changed" swapped="no" />
                    <layout>
                      <property name="column">1</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="date_value_box">
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="ending_value_box">
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">1</property>
                    <style>
                      <class name="frame" />
                    </style>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                    <child>
                      <object class="GtkLabel" id="start_value">
                        <property name="halign">start</property>
                        <property name="margin-start">3</property>
                        <property name="margin-end">3</property>
                        <property name="margin-top">3</property>
                        <property name="margin-bottom">3</property>
                        <property name="label">$15.00</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbuttonbox1">
                <property name="visible">True</property>
<child>
                  <object class="GtkButton" id="interest_button">
                    <property name="label" translatable="1">Enter _Interest Payment…</property>
                    <property name="focusable">1</property>
<property name="use-underline">1</property>
                    <signal name="clicked" handler="gnc_start_recn_interest_clicked_cb" swapped="no" />
                  </object>

                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="future_warning">
                <property name="visible">0</property>
                <property name="halign">center</property>
                <child>
                  <object class="GtkImage" id="future_icon">
                    <property name="icon-name">dialog-warning</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="future_text">
                    <property name="margin-start">3</property>
                    <property name="margin-end">3</property>
                    <property name="label" translatable="1">Statement Date is after today</property>
                    <property name="wrap">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="reconcile_start_actions">
            <property name="orientation">horizontal</property>
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="cancelbutton1">
                <property name="label" translatable="1">_Cancel</property>
                <property name="focusable">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="okbutton1">
                <property name="label" translatable="1">_OK</property>
                <property name="focusable">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
