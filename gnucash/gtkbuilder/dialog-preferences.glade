                        <property name="focusable">1</property>
                        <property name="has-tooltip">1</property>
                        <property name="tooltip-markup">Show a grand total of all accounts converted to the default report currency.</property>
                        <property name="tooltip-text" translatable="1">Show a grand total of all accounts converted to the default report currency.</property>
