<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="choose_owner_dialog">
    <property name="title" translatable="1">Choose Owner Dialog</property>
<child>
      <object class="GtkBox" id="choose_owner_window_root">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="dialog-vbox3">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="title_label">
                <property name="valign">center</property>
                <property name="label">(docs)</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="hseparator1" />
            </child>
            <child>
              <object class="GtkGrid">
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label4">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Description</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="desc_label">
                    <property name="label">(desc)</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="owner_label">
                    <property name="halign">end</property>
                    <property name="label">(owner)</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="owner_box">
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
        <child>
      <object class="GtkBox" id="dialog-action_area3">
        <property name="halign">end</property>
        <property name="spacing">6</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="cancelbutton1">
            <signal name="clicked" handler="choose_owner_cancel_cb" swapped="no" />
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="okbutton1">
            <signal name="clicked" handler="choose_owner_apply_cb" swapped="no" />
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
      </object>
        </child>
      </object>
    </child>
  </object>
</interface>
