<gnc-act:title>
  Spouse Superannuation
</gnc-act:title>
<gnc-act:short-description>
  Superannuation account with related investment subaccounts for a spouse
</gnc-act:short-description>
<gnc-act:long-description>
  You would want to select this set of accounts if you track your spouse's superannuation (shares, bonds, managed funds, index funds).
</gnc-act:long-description>

<gnc:account version="2.0.0">
  <act:name>Root Account</act:name>
  <act:id type="new">1972cce2e2364f95b2b0bc014502661d</act:id>
  <act:type>ROOT</act:type>
  <act:commodity-scu>0</act:commodity-scu>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Assets</act:name>
  <act:id type="new">3075ccb22b2d5fe3a8c86ed58c364a80</act:id>
  <act:type>ASSET</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Assets</act:description>
  <act:parent type="new">1972cce2e2364f95b2b0bc014502661d</act:parent>
  <act:slots>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Investments</act:name>
  <act:id type="new">ed194a49f8f25b59a2229bf595406fec</act:id>
  <act:type>ASSET</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Investments</act:description>
  <act:parent type="new">3075ccb22b2d5fe3a8c86ed58c364a80</act:parent>
  <act:slots>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
<gnc:account version="2.0.0">
  <act:name>Spouse Superannuation</act:name>
  <act:id type="new">d82519cdc22f50c4a7f64edb7d46ebd1</act:id>
  <act:type>BANK</act:type>
  <act:commodity>
    <cmdty:space>ISO4217</cmdty:space>
    <cmdty:id>AUD</cmdty:id>
  </act:commodity>
  <act:description>Spouse Superannuation</act:description>
  <act:parent type="new">ed194a49f8f25b59a2229bf595406fec</act:parent>
  <act:slots>
    <slot>
      <slot:key>notes</slot:key>
      <slot:value type="string">Industry, retail or self-managed super fund</slot:value>
    </slot>
    <slot>
      <slot:key>placeholder</slot:key>
      <slot:value type="string">true</slot:value>
    </slot>
  </act:slots>
</gnc:account>
