<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="cust_days_in_adj">
    <property name="lower">1</property>
    <property name="upper">180</property>
    <property name="value">7</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="days_in_adj">
    <property name="lower">1</property>
    <property name="upper">180</property>
    <property name="value">7</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkWindow" id="preferences_window">
    <property name="visible">1</property>
    <property name="title" translatable="1">Preferences</property>
    <property name="child">
      <object class="GtkGrid" id="business_prefs">
<property name="row-spacing">3</property>
        <property name="column-spacing">6</property>
        <child>
          <object class="GtkLabel">
            <property name="halign">start</property>
            <property name="label" translatable="1">General</property>
            <style>
              <class name="gnc-class-strong" />
            </style>
            <layout>
              <property name="column">0</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/enable-toolbuttons">
            <property name="label" translatable="1">Enable extra _buttons</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">If active, extra toolbar buttons for common business functions are shown as well. Otherwise they are not shown.</property>
            <property name="tooltip-text" translatable="1">If active, extra toolbar buttons for common business functions are shown as well. Otherwise they are not shown.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/use-new-window">
            <property name="label" translatable="1">_Open in new window</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">If checked, each invoice will be opened in its own top level window. If clear, the invoice will be opened in the current window.</property>
            <property name="tooltip-text" translatable="1">If checked, each invoice will be opened in its own top level window. If clear, the invoice will be opened in the current window.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/accumulate-splits">
            <property name="label" translatable="1">_Accumulate splits on post</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">Whether multiple entries in an invoice which transfer to the same account should be accumulated into a single split by default. This setting can be changed in the Post dialog.</property>
            <property name="tooltip-text" translatable="1">Whether multiple entries in an invoice which transfer to the same account should be accumulated into a single split by default. This setting can be changed in the Post dialog.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">3</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <layout>
              <property name="column">0</property>
              <property name="row">4</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="halign">start</property>
            <property name="label" translatable="1">Invoices</property>
            <style>
              <class name="gnc-class-strong" />
            </style>
            <property name="use-markup">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">5</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/notify-when-due">
            <property name="label" translatable="1">Not_ify when due</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">Whether to display the list of Bills Due at startup.</property>
            <property name="tooltip-text" translatable="1">Whether to display the list of Bills Due at startup.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">6</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/tax-included">
            <property name="label" translatable="1">_Tax included</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">Whether tax is included by default in entries on Bills. This setting is inherited by new customers and vendors.</property>
            <property name="tooltip-text" translatable="1">Whether tax is included by default in entries on Bills. This setting is inherited by new customers and vendors.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">7</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.invoice/auto-pay">
            <property name="label" translatable="1" comments="See the tooltip &quot;At post time…&quot; for details.">_Process payments on posting</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">At post time, automatically attempt to pay customer items with outstanding pre-payments and counter items. The pre-payments and items obviously have to be against the same customer. Counter items are items with opposite sign. For example for an invoice, customer credit notes and negative invoices are considered counter items.</property>
            <property name="tooltip-text" translatable="1">At post time, automatically attempt to pay customer items with outstanding pre-payments and counter items. The pre-payments and items obviously have to be against the same customer. Counter items are items with opposite sign. For example for an invoice, customer credit notes and negative invoices are considered counter items.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">8</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <layout>
              <property name="column">0</property>
              <property name="row">10</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="halign">start</property>
            <property name="label" translatable="1">Bills</property>
            <style>
              <class name="gnc-class-strong" />
            </style>
            <property name="use-markup">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">11</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.bill/notify-when-due">
            <property name="label" translatable="1">_Notify when due</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">Whether to display the list of Bills Due at startup.</property>
            <property name="tooltip-text" translatable="1">Whether to display the list of Bills Due at startup.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">12</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.bill/tax-included">
            <property name="label" translatable="1">Ta_x included</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">Whether tax is included by default in entries on Invoices. This setting is inherited by new customers and vendors.</property>
            <property name="tooltip-text" translatable="1">Whether tax is included by default in entries on Invoices. This setting is inherited by new customers and vendors.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">13</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="pref/dialogs.business.bill/auto-pay">
            <property name="label" translatable="1" comments="See the tooltip &quot;At post time…&quot; for details.">Pro_cess payments on posting</property>
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">At post time, automatically attempt to pay vendor items with outstanding pre-payments and counter items. The pre-payments and items obviously have to be against the same vendor. Counter items are items with opposite sign. For example for a bill, vendor credit notes and negative bills are considered counter items.</property>
            <property name="tooltip-text" translatable="1">At post time, automatically attempt to pay vendor items with outstanding pre-payments and counter items. The pre-payments and items obviously have to be against the same vendor. Counter items are items with opposite sign. For example for a bill, vendor credit notes and negative bills are considered counter items.</property>
            <property name="halign">start</property>
            <property name="use-underline">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">14</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="1">Days in ad_vance</property>
            <property name="use-underline">1</property>
            <property name="mnemonic-widget">pref/dialogs.business.bill/days-in-advance</property>
            <layout>
              <property name="column">1</property>
              <property name="row">12</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkSpinButton" id="pref/dialogs.business.bill/days-in-advance">
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">How many days in the future to warn about Bills coming due.</property>
            <property name="tooltip-text" translatable="1">How many days in the future to warn about Bills coming due.</property>
            <property name="adjustment">days_in_adj</property>
            <property name="climb-rate">1</property>
            <layout>
              <property name="column">2</property>
              <property name="row">12</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkSpinButton" id="pref/dialogs.business.invoice/days-in-advance">
            <property name="focusable">1</property>
            <property name="has-tooltip">1</property>
            <property name="tooltip-markup">How many days in the future to warn about Invoices coming due.</property>
            <property name="tooltip-text" translatable="1">How many days in the future to warn about Invoices coming due.</property>
            <property name="adjustment">cust_days_in_adj</property>
            <layout>
              <property name="column">2</property>
              <property name="row">6</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="1">_Days in advance</property>
            <property name="use-underline">1</property>
            <property name="mnemonic-widget">pref/dialogs.business.invoice/days-in-advance</property>
            <layout>
              <property name="column">1</property>
              <property name="row">6</property>
            </layout>
          </object>
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
        <child>
          <placeholder />
        </child>
      </object>
    </property>
  </object>
</interface>
