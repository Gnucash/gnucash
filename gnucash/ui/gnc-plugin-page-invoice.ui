    <child>
      <object class="GtkButton" id="but16">

        <property name="action-name">GncPluginPageInvoiceActions.EditUnpostInvoiceAction</property>
        <property name="tooltip-text" translatable="1">Unpost this invoice and make it editable</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">gnc-invoice-unpost</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Unpost Invoice</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but17">

        <property name="action-name">GncPluginPageInvoiceActions.ToolsProcessPaymentAction</property>
        <property name="tooltip-text" translatable="1">Enter a payment for the owner of this invoice</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">gnc-invoice-pay</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Pay Invoice</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
