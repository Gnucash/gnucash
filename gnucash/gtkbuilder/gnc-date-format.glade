<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkStringList" id="format-model">
    <items>
      <item translatable="yes">US (12/31/2001)</item>
      <item translatable="yes">UK (31/12/2001)</item>
      <item translatable="yes">Europe (31.12.2001)</item>
      <item translatable="yes">ISO (2001-12-31)</item>
      <item translatable="yes">Locale</item>
      <item translatable="yes">UTC - Coordinated Universal Time</item>
      <item translatable="yes">Custom</item>
      <item translatable="yes">No Fancy Date Format</item>
    </items>
  </object>
  <object class="GtkGrid" id="date_format_table">
    <property name="row-spacing">3</property>
    <property name="column-spacing">6</property>
    <child>
      <object class="GtkLabel" id="sample_label">
        <property name="halign">start</property>
        <property name="margin-top">3</property>
        <property name="label">December 31, 2000</property>
        <layout>
          <property name="column">2</property>
          <property name="row">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="format_entry">
        <property name="focusable">1</property>
        <property name="text" translatable="1">%Y-%m-%d</property>
        <signal name="changed" handler="gnc_ui_date_format_changed_cb" swapped="no" />
        <layout>
          <property name="column">2</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="years_button">
        <property name="label" translatable="1">Include Century</property>
        <property name="focusable">1</property>
        <property name="halign">start</property>
        <property name="use-underline">1</property>
        <property name="active">1</property>
        <signal name="toggled" handler="gnc_ui_date_format_changed_cb" swapped="no" />
        <layout>
          <property name="column">2</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="months_hbox">
        <layout>
          <property name="column">2</property>
          <property name="row">1</property>
        </layout>
        <child>
          <object class="GtkCheckButton" id="month_number_button">
            <property name="halign">center</property>
            <property name="label" translatable="1">Number</property>
            <property name="focusable">1</property>
            <property name="use-underline">1</property>
            <property name="active">1</property>
            <signal name="toggled" handler="gnc_ui_date_format_changed_cb" swapped="no" />
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="month_abbrev_button">
            <property name="halign">center</property>
            <property name="label" translatable="1">Abbreviation</property>
            <property name="focusable">1</property>
            <property name="use-underline">1</property>
            <property name="group">month_number_button</property>
            <signal name="toggled" handler="gnc_ui_date_format_changed_cb" swapped="no" />
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="month_name_button">
            <property name="halign">center</property>
            <property name="label" translatable="1">Name</property>
            <property name="focusable">1</property>
            <property name="use-underline">1</property>
            <property name="group">month_number_button</property>
            <signal name="toggled" handler="gnc_ui_date_format_changed_cb" swapped="no" />
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="label1">
        <property name="justify">center</property>
        <layout>
          <property name="column">0</property>
          <property name="row">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="months_label">
        <property name="halign">start</property>
        <property name="label" translatable="1">Months</property>
        <layout>
          <property name="column">1</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="years_label">
        <property name="halign">start</property>
        <property name="label" translatable="1">Years</property>
        <layout>
          <property name="column">1</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="format_label">
        <property name="halign">start</property>
        <property name="label" translatable="1">Format</property>
        <layout>
          <property name="column">1</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="label2">
        <property name="halign">start</property>
        <property name="margin-top">3</property>
        <property name="label" translatable="1">Sample</property>
        <layout>
          <property name="column">1</property>
          <property name="row">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="label_box">
        <property name="halign">end</property>
        <property name="margin-end">6</property>
        <property name="spacing">8</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="GtkLabel" id="widget_label">
            <property name="halign">start</property>
            <property name="label" translatable="1">Date format</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkDropDown" id="format_dropdown">
        <property name="model">format-model</property>
        <layout>
          <property name="column">1</property>
          <property name="row">0</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <placeholder />
    </child>
    <child>
      <placeholder />
    </child>
    <child>
      <placeholder />
    </child>
  </object>
</interface>
