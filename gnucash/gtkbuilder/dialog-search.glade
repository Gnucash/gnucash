<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="search_dialog">
    <child>
      <object class="GtkBox" id="dialog-vbox3">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="vbox89">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="search_hbox">
                <property name="valign">center</property>
                <child>
                  <object class="GtkBox" id="hbox72">
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkLabel" id="type_label">
                        <property name="halign">center</property>
                        <property name="label">()</property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label844">
                        <property name="halign">center</property>
                        <property name="label" translatable="1"> Search </property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="search_frame">
<property name="child">
                  <object class="GtkBox" id="vbox88">
<property name="orientation">vertical</property>
                    <child>
                      <object class="GtkCenterBox" id="hbox73">
                        <property name="valign">center</property>
<property name="start-widget">
                          <object class="GtkBox">
                            <child>
                              <object class="GtkBox" id="add_button_box">
                                <property name="halign">center</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="end-widget">
                          <object class="GtkBox">
                            <child>
                              <object class="GtkLabel" id="label846">
                                <property name="halign">center</property>
                                <property name="label" translatable="1">Search for items where</property>
                                <property name="justify">right</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="type_menu_box">
                                <property name="halign">center</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="match_all_label">
                        <property name="valign">center</property>
                        <property name="label" translatable="1">Match all entries</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="criteria_scroll_window">
                        <property name="vexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="hscrollbar-policy">never</property>
<property name="child">
                          <object class="GtkViewport" id="criteria_viewport">
<property name="child">
                              <object class="GtkGrid" id="criteria_table">
<child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel" id="label845">
                    <property name="label" translatable="1">Search Criteria</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="result_hbox">
                <property name="vexpand">1</property>
<child>
                  <object class="GtkBox" id="hboxXXX">
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkFrame" id="frame12">
                        <property name="child">
                          <object class="GtkBox" id="vbox24">
<property name="orientation">vertical</property>
                            <child>
                              <object class="GtkCheckButton" id="new_search_radiobutton">
                                <property name="valign">center</property>
                                <property name="label" translatable="1">New search</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="active">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="narrow_search_radiobutton">
                                <property name="valign">center</property>
                                <property name="label" translatable="1">Refine current search</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="group">new_search_radiobutton</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="add_search_radiobutton">
                                <property name="valign">center</property>
                                <property name="label" translatable="1">Add results to current search</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="group">new_search_radiobutton</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="delete_search_radiobutton">
                                <property name="valign">center</property>
                                <property name="label" translatable="1">Delete results from current search</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="group">new_search_radiobutton</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator" id="hseparator1" />
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="active_only_check">
                                <property name="valign">center</property>
                                <property name="label" translatable="1">Search only active data</property>
                                <property name="focusable">1</property>
                                <property name="has-tooltip">1</property>
                                <property name="tooltip-markup">Choose whether to search all your data or only that marked as &amp;quot;active&amp;quot;.</property>
                                <property name="tooltip-text" translatable="1">Choose whether to search all your data or only that marked as "active".</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="active">1</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <child type="label">
                          <object class="GtkLabel" id="label847">
                            <property name="label" translatable="1">Type of search</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area3">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="hexpand">1</property>
            <property name="margin-top">8</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="help_button">
                <property name="hexpand">1</property>
                <property name="halign">start</property>
                <property name="label" translatable="1">_Help</property>
                <property name="focusable">1</property>
    <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>

            </child>
            <child>
              <object class="GtkButton" id="new_item_button">
                <property name="label" translatable="1">_New item…</property>
                <property name="focusable">1</property>
    <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>

            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="label" translatable="1">_Close</property>
                <property name="focusable">1</property>
    <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>

            </child>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="1">_Cancel</property>
                <property name="focusable">1</property>
    <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>

            </child>
            <child>
              <object class="GtkButton" id="find_button">
                <property name="label" translatable="1">_Find</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>

            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
