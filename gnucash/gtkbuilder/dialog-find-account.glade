<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />

  <object class="GtkWindow" id="find_account_window">
    <property name="title" translatable="1">Search the Account List</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <property name="child">
      <object class="GtkCenterBox" id="dialog-vbox">
        <property name="visible">0</property>
        <property name="orientation">vertical</property>
        <property name="start-widget">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="label5">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">Search the Account List</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="frame-radio">
                <property name="valign">center</property>
                <property name="halign">start</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="margin-bottom">6</property>
<property name="child">
                  <object class="GtkBox" id="hbox-radio">
                    <property name="halign">start</property>
<property name="orientation">vertical</property>
                    <property name="homogeneous">1</property>
                    <child>
                      <object class="GtkCheckButton" id="radio-root">
                        <property name="valign">center</property>
                        <property name="label" translatable="1">All _accounts</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="radio-subroot">
                        <property name="valign">center</property>
                        <property name="label">Su_b-accounts of</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <property name="group">radio-root</property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="label" translatable="1">Search scope</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrollwindow">
                <property name="vexpand">1</property>
                <property name="focusable">1</property>
                <property name="child">
                  <object class="GtkColumnView" id="treeview">
                    <property name="focusable">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="filter-label">
                <property name="valign">center</property>
                <property name="margin-top">3</property>
                <property name="margin-bottom">3</property>
                <property name="label" translatable="1">Case insensitive searching is available on 'Account Full Name'.</property>
                <property name="justify">center</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="label6">
                    <property name="hexpand">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="filter-text-entry">
                    <property name="hexpand">1</property>
                    <property name="focusable">1</property>
</object>
                </child>
                <child>
                  <object class="GtkButton" id="filter-button">
                    <property name="label" translatable="1">Sea_rch</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label7">
                    <property name="hexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label8">
                <property name="valign">center</property>
                <property name="margin-top">3</property>
                <property name="margin-bottom">3</property>
                <property name="label" translatable="1">Select a row and then press 'jump to' to jump to the account in the Account Tree,
if account should not be shown, this will be temporarily overridden.</property>
                <property name="justify">center</property>
              </object>
            </child>
          </object>
        </property>
        <property name="end-widget">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="buttonbox">
                <property name="halign">end</property>
                <property name="spacing">6</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkCheckButton" id="check_button">
                    <property name="label" translatable="1">Close _on Jump</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <property name="active">1</property>
                  </object>

                </child>
                <child>
                  <object class="GtkButton" id="jumpto_button">
                    <property name="label" translatable="1">_Jump To</property>
                    <property name="focusable">1</property>
                    <property name="use-underline">1</property>
                  </object>

                </child>
                <child>
                  <object class="GtkButton" id="close_button">
                    <property name="label" translatable="1">_Close</property>
                    <property name="focusable">1</property>
                    <property name="use-underline">1</property>
                  </object>

                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
