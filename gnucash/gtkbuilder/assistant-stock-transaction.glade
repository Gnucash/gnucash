<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="stock_transaction_assistant">
    <property name="title" translatable="1">Stock Transaction Assistant</property>
    <property name="default-width">500</property>
    <property name="default-height">520</property>
    <signal name="close-request" handler="stock_assistant_close_request_cb" swapped="no" />
    <child>
      <object class="GtkBox" id="stock_assistant_content">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkLabel" id="stock_assistant_page_title">
            <property name="halign">start</property>
            <property name="xalign">0</property>
            <style><class name="title-2" /></style>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="stock_assistant_stack">
            <property name="vexpand">1</property>
            <property name="transition-type">slide-left-right</property>    <child>
      <object class="GtkStackPage">
        <property name="name">intro</property>
        <property name="title" translatable="1">Stock Transaction Assistant</property>
<property name="child">
          <object class="GtkLabel" id="intro_page_label">
            <property name="valign">start</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="label" translatable="1">This assistant will help you record a stock transaction. The transaction type (purchase, sale, dividend, distribution, return of capital, stock split) will determine the transaction splits involved in the transaction. Note that the transaction currency will be that of the stock account and that multi-currency transactions are not supported: Only accounts in the transaction currency will be offered for cash, capital gains, dividends, and fees.</property>
            <property name="wrap">1</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">transaction-details</property>
        <property name="title" translatable="1">Transaction Details</property>
<property name="child">
          <object class="GtkBox" id="transaction_details_page">
            <property name="margin-start">12</property>
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="transaction_details_label">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">Select the date and description for your records.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="transaction_details_table">
                <property name="hexpand">1</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="transaction_date_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Date</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="transaction_description_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Description</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="transaction_description_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">transaction-type</property>
        <property name="title" translatable="1">Transaction Type</property>
<property name="child">
          <object class="GtkBox" id="transaction_type_page">
            <property name="margin-start">12</property>
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="transaction_type_page_label">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">Select the type of stock activity that you wish to record. The available types depend on whether the current stock balance is positive, nil, or negative (i.e. when shorting stock). The type will determine the component splits.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="transaction_type_table">
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="transaction_type_combo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Type</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="transaction_type_page_combobox">
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="transaction_type_page_explanation">
                    <property name="label">label</property>
                    <property name="wrap">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">stock-amount</property>
        <property name="title" translatable="1">Stock Amount</property>
<property name="child">
          <object class="GtkBox" id="stock_amount_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_amount_title">
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">Enter the number of shares you gained or lost in the transaction.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="stock_amount_table">
                <property name="valign">center</property>
<property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="stock_amount_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Shares</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="prev_balance_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Previous Balance</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="prev_balance_amount">
                    <property name="halign">end</property>
                    <property name="hexpand">1</property>
                    <property name="label">(Previous Balance)</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="next_balance_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Next Balance</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="next_balance_amount">
                    <property name="halign">end</property>
                    <property name="label">(Next Balance)</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">stock-value</property>
        <property name="title" translatable="1">Stock Value</property>
<property name="child">
          <object class="GtkBox" id="stock_value_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_value_title">
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">Enter the value of the shares.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="stock_value_table">
                <property name="valign">center</property>
<property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="stock_price_amount">
                    <property name="halign">end</property>
                    <property name="label">(autocalculated price)</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="stock_memo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Memo</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="stock_memo_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="text" translatable="1">Gross value</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="stock_price_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Price</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="stock_value_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Stock Value</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">cash</property>
        <property name="title" translatable="1">Cash</property>
<property name="child">
          <object class="GtkBox" id="cash_details_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_cash_title">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">In this page, input the asset account, and the monetary amount received/spent. It may differ from the stock value from the last page, if there are brokerage fees associated with this transaction.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="cash_table">
                <property name="valign">center</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="cash_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Amount</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="cash_memo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Memo</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">cash_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="cash_memo_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="text" translatable="1">Net value</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="cash_amount_box">
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="cash_account_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Cash Account</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">cash_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">fees</property>
        <property name="title" translatable="1">Fees</property>
<property name="child">
          <object class="GtkBox" id="fees_details_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_fees_title">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">In this page, input any brokerage fees incurred in this transaction. The fee may be capitalized into the asset account, or expensed into a brokerage fees account. Typically fees on purchase are capitalized, and fees on sales are expensed. If there are no fees involved in this transaction, it can be left blank.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="fees_table">
                <property name="valign">center</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="fees_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Amount</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="fees_memo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Memo</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">fees_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="fees_memo_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="text" translatable="1">Fees</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="fees_amount_box">
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="fees_account_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Brokerage Fees</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">fees_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="capitalize_fees_checkbutton">
                    <property name="label" translatable="1">Capitalize brokerage fees into stock account?</property>
                    <property name="focusable">1</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="column-span">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">dividend</property>
        <property name="title" translatable="1">Dividend</property>
<property name="child">
          <object class="GtkBox" id="dividend_details_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_dividend_title">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">In this page, input any dividend income received in this transaction.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="dividend_table">
                <property name="valign">center</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="dividend_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Amount</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dividend_memo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Memo</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">dividend_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="dividend_memo_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="text" translatable="1">Dividend</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="dividend_amount_box">
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dividend_account_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Dividend Account</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">dividend_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">capital-gains</property>
        <property name="title" translatable="1">Capital Gains</property>
<property name="child">
          <object class="GtkBox" id="capgains_details_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="stock_capgains_title">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">In this page, input any capital gains or losses incurred, and the associated income account. Capital gains are positive, and capital losses are negative.</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="capgains_table">
                <property name="valign">center</property>
                <property name="row-spacing">3</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="capgains_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Amount</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="capgains_memo_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">_Memo</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">capgains_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="capgains_memo_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="text" translatable="1">Capital Gain/Loss</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="capgains_amount_box">
                    <property name="hexpand">1</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="capgains_account_label">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Capital Gains Account</property>
                    <property name="use-underline">1</property>
                    <property name="justify">center</property>
                    <property name="mnemonic-widget">capgains_memo_entry</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStackPage">
        <property name="name">finish</property>
        <property name="title" translatable="1">Finish</property>
<property name="child">
          <object class="GtkBox" id="finish_page">
<property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="finish_page_label">
                <property name="valign">center</property>
                <property name="margin-bottom">6</property>
                <property name="label" translatable="1">A summary of splits is shown as follows. If the summary is correct, and there are no errors, please press "Apply". You may also press "Back" to review your choices, or "Cancel" to quit without making any changes. </property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="finish_scrolled">
                <property name="vexpand">1</property>
                <property name="focusable">1</property>
                <property name="vscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkColumnView" id="transaction_view">
                    <property name="focusable">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="finish_summary">
                <property name="label">summary of errors</property>
                <property name="wrap">1</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>          </object>
        </child>
        <child>
          <object class="GtkBox" id="stock_assistant_actions">
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="stock_assistant_cancel">
                <property name="label" translatable="1">_Cancel</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="stock_assistant_cancel_cb" swapped="no" />
              </object>
            </child>
            <child>
              <object class="GtkButton" id="stock_assistant_back">
                <property name="label" translatable="1">_Back</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="stock_assistant_back_cb" swapped="no" />
              </object>
            </child>
            <child>
              <object class="GtkButton" id="stock_assistant_next">
                <property name="label" translatable="1">_Next</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="stock_assistant_next_cb" swapped="no" />
              </object>
            </child>
            <child>
              <object class="GtkButton" id="stock_assistant_apply">
                <property name="label" translatable="1">_Apply</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="stock_assistant_finish_cb" swapped="no" />
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
