<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="FilePlaceholder3">
    <item>
      <attribute name="label" translatable="yes">_Print Report…</attribute>
      <attribute name="action">GncPluginPageReportActions.FilePrintAction</attribute>
      <attribute name="accel">&lt;Primary&gt;p</attribute>
      <attribute name="tooltip" translatable="yes">Print the current report</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="EditPlaceholder3">
    <item>
      <attribute name="label" translatable="yes">_Find…</attribute>
      <attribute name="action">gnc-plugin-basic-commands-actions.EditFindTransactionsAction</attribute>
      <attribute name="accel">&lt;Primary&gt;f</attribute>
      <attribute name="tooltip" translatable="yes">Find transactions with a search</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="EditPlaceholder5">
    <item>
      <attribute name="label" translatable="yes">_Report Options</attribute>
      <attribute name="action">GncPluginPageReportActions.ReportOptionsAction</attribute>
      <attribute name="tooltip" translatable="yes">Edit report style sheets</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="EditPlaceholder6">
    <item>
      <attribute name="label" translatable="yes">Ta_x Report Options</attribute>
      <attribute name="action">GncPluginPageReportActions.EditTaxOptionsAction</attribute>
      <attribute name="tooltip" translatable="yes">Setup relevant accounts for tax reports, e.g. US income tax</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="ViewPlaceholder4">
    <item>
      <attribute name="label" translatable="yes">_Refresh</attribute>
      <attribute name="action">GncPluginPageReportActions.ViewRefreshAction</attribute>
      <attribute name="accel">&lt;Primary&gt;r</attribute>
      <attribute name="tooltip" translatable="yes">Refresh this window</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="FilePlaceholder4">
    <item>
      <attribute name="label" translatable="yes">Export as P_DF…</attribute>
      <attribute name="action">GncPluginPageReportActions.FilePrintPDFAction</attribute>
      <attribute name="tooltip" translatable="yes">Export the current report as a PDF document</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="FilePlaceholder5">
    <item>
      <attribute name="label" translatable="yes">Export _Report…</attribute>
      <attribute name="action">GncPluginPageReportActions.ReportExportAction</attribute>
      <attribute name="tooltip" translatable="yes">Export HTML-formatted report to file</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="ReportsPlaceholder1">
    <item>
      <attribute name="label" translatable="yes">Save _Report Configuration</attribute>
      <attribute name="action">GncPluginPageReportActions.ReportSaveAction</attribute>
      <attribute name="accel">&lt;Primary&gt;&lt;Alt&gt;s</attribute>
      <attribute name="tooltip" translatable="yes">Update the current report&apos;s saved configuration</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Save Report Configuration As…</attribute>
      <attribute name="action">GncPluginPageReportActions.ReportSaveAsAction</attribute>
      <attribute name="accel">&lt;Primary&gt;&lt;Alt&gt;&lt;Shift&gt;s</attribute>
      <attribute name="tooltip" translatable="yes">Add the current report&apos;s configuration to the &apos;Reports-&gt;Saved Report Configurations&apos; menu</attribute>
      <attribute name="temp" translatable="no">yes</attribute>
    </item>
  </menu>
  <menu id="mainwin-popup">
    <item>
      <attribute name="label" translatable="no">_Test</attribute>
      <attribute name="action">mainwin.TestAction</attribute>
    </item>
  </menu>
  <object class="GtkBox" id="mainwin-toolbar">
    <property name="css-classes">toolbar</property>
    <child>
      <object class="GtkButton" id="but1">

        <property name="action-name">gnc-plugin-basic-commands-actions.FileSaveAction</property>
        <property name="tooltip-text" translatable="1">Save the current file</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-save</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Save</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but2">

        <property name="action-name">mainwin.FileCloseAction</property>
        <property name="tooltip-text" translatable="1">Close the currently active page</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">window-close</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Close</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator">
        <property name="orientation">vertical</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but2a">

        <property name="action-name">gnc-plugin-business-actions.ToolbarNewInvoiceAction</property>
        <property name="tooltip-text" translatable="1">Open the New Invoice dialog</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">gnc-invoice-new</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">New _Invoice…</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator" id="extra_separator">
        <property name="orientation">vertical</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but3">

        <property name="action-name">GncPluginPageReportActions.ReportBackAction</property>
        <property name="tooltip-text" translatable="1">Move back one step in the history</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-previous</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Back</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but4">

        <property name="action-name">GncPluginPageReportActions.ReportForwAction</property>
        <property name="tooltip-text" translatable="1">Move forward one step in the history</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-next</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Forward</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but5">

        <property name="action-name">GncPluginPageReportActions.ReportReloadAction</property>
        <property name="tooltip-text" translatable="1">Reload the current page</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">view-refresh</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Reload</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but6">

        <property name="action-name">GncPluginPageReportActions.ReportStopAction</property>
        <property name="tooltip-text" translatable="1">Cancel outstanding HTML requests</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">process-stop</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Stop</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator">
        <property name="orientation">vertical</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but7">

        <property name="action-name">GncPluginPageReportActions.ReportOptionsAction</property>
        <property name="tooltip-text" translatable="1">Edit report options</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-properties</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Report Options</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but8">

        <property name="action-name">GncPluginPageReportActions.ReportSaveAction</property>
        <property name="tooltip-text" translatable="1">Update the current report&apos;s saved configuration</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-save</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Save _Report Configuration</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but9">

        <property name="action-name">GncPluginPageReportActions.ReportSaveAsAction</property>
        <property name="tooltip-text" translatable="1">Add the current report&apos;s configuration to the &apos;Reports-&gt;Saved Report Configurations&apos; menu</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-save-as</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Save Report Configuration As…</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but10">

        <property name="action-name">GncPluginPageReportActions.ReportExportAction</property>
        <property name="tooltip-text" translatable="1">Export HTML-formatted report to file</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-next</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Export _Report</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but11">

        <property name="action-name">GncPluginPageReportActions.FilePrintAction</property>
        <property name="tooltip-text" translatable="1">Print the current report</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-print</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">_Print Report…</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="but12">

        <property name="action-name">GncPluginPageReportActions.FilePrintPDFAction</property>
        <property name="tooltip-text" translatable="1">Export the current report as a PDF document</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">gnc-gnome-pdf</property>
                <property name="pixel-size">24</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="1">Export as P_DF…</property>
                <property name="use-underline">1</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
