<gnc-act:title>
  Investment Accounts
</gnc-act:title>
<gnc-act:short-description>
  Share trading account with related investment accounts (shares, exchange traded funds, managed funds, bonds, interest, dividends)
</gnc-act:short-description>
<gnc-act:long-description>
  You would want to select this set of accounts if you have investments (shares, exchange traded funds, managed funds, bonds, interest, dividends).
</gnc-act:long-description>

<gnc:account version="2.0.0">
  <act:name>Root Account</act:name>
  <act:id type="new">1972cce2e2364f95b2b0bc014502661d</act:id>
  <act:type>ROOT</act:type>
  <act:commodity-scu>0</act:commodity-scu>
</gnc:account>
