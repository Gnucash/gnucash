  <object class="GtkWindow" id="aqbanking_connection_dialog">
    <property name="title" translatable="1">Online Banking Connection Window</property>
    <property name="default-width">350</property>
    <property name="default-height">500</property>
    <signal name="close-request" handler="ggg_delete_event_cb" swapped="no"/>
