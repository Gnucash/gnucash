<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="custom_report_window">
    <property name="title" translatable="1">Saved Report Configurations</property>
    <property name="modal">True</property>
    <property name="default-width">520</property>
    <property name="default-height">330</property>
    <child>
      <object class="GtkBox" id="custom_report_content">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkScrolledWindow" id="custom_report_sw">
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>
            <property name="min-content-width">300</property>
            <property name="min-content-height">150</property>
            <child>
              <object class="GtkColumnView" id="custom_report_list_view">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="show-row-separators">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="no_report_notification">
            <property name="visible">False</property>
            <property name="vexpand">True</property>
            <property name="wrap">True</property>
            <property name="label" translatable="1">Currently you have no saved reports.</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="custom_report_status">
            <property name="visible">False</property>
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <property name="selectable">True</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="custom_report_instructions">
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <property name="label" translatable="1">Saved report configurations are created by
1. opening a report from the Reports menu,
2. altering the report's options to your taste,
3. selecting &quot;Save Report Configuration [As…]&quot; from the Reports menu
or pressing a &quot;Save Config [As…]&quot; button on the tool bar.</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="custom_report_actions">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="hexpand">1</property>
            <child>
              <object class="GtkButton" id="help_button">
                <property name="hexpand">1</property>
                <property name="halign">start</property>
                <property name="label" translatable="1">_Help</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_report_button">
                <property name="label" translatable="1">_Close</property>
                <property name="use-underline">True</property>
                <property name="tooltip-text" translatable="1">Exit the saved report configurations dialog</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
