<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="lot_viewer_dialog">
    <property name="title" translatable="1">Lot Viewer</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <property name="child">
      <object class="GtkBox" id="lot_viewer_root">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPaned" id="lot_vpaned">
            <property name="orientation">vertical</property>
            <property name="position">200</property>
            <property name="vexpand">1</property>
            <property name="start-child">
              <object class="GtkPaned" id="lot_hpaned">
                <property name="position">200</property>
                <property name="start-child">
                  <object class="GtkGrid" id="lot_detail_grid">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                    <property name="row-spacing">3</property>
                    <child>
                      <object class="GtkLabel" id="lot_title_label">
                        <property name="label" translatable="1">_Title</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">lot_title_entry</property>
                        <property name="halign">start</property>
                        <style><class name="gnc-class-strong"/></style>
                        <layout><property name="column">0</property><property name="row">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="lot_title_entry">
                        <property name="hexpand">1</property>
                        <property name="tooltip-text" translatable="1">Enter a name for the highlighted lot.</property>
                        <layout><property name="column">0</property><property name="row">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lot_notes_label">
                        <property name="label" translatable="1">_Notes</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">lot_notes_text</property>
                        <property name="halign">start</property>
                        <style><class name="gnc-class-strong"/></style>
                        <layout><property name="column">0</property><property name="row">2</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="lot_notes_scroller">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="child">
                          <object class="GtkTextView" id="lot_notes_text">
                            <property name="wrap-mode">word</property>
                            <property name="tooltip-text" translatable="1">Enter any notes you want to make about this lot.</property>
                          </object>
                        </property>
                        <layout><property name="column">0</property><property name="row">3</property></layout>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkGrid" id="lot_list_grid">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                    <property name="row-spacing">3</property>
                    <child>
                      <object class="GtkLabel" id="lots_label">
                        <property name="label" translatable="1">_Lots in This Account</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">lot_view</property>
                        <property name="halign">start</property>
                        <style><class name="gnc-class-strong"/></style>
                        <layout><property name="column">0</property><property name="row">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="lot_scroller">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="child"><object class="GtkColumnView" id="lot_view"/></property>
                        <layout><property name="column">0</property><property name="row">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="only_show_open_lots_checkbutton">
                        <property name="label" translatable="1">Show only open lots</property>
                        <property name="halign">start</property>
                        <layout><property name="column">0</property><property name="row">2</property></layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="end-child">
              <object class="GtkPaned" id="split_hpaned">
                <property name="position">200</property>
                <property name="start-child">
                  <object class="GtkGrid" id="free_split_grid">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">3</property>
                    <property name="row-spacing">3</property>
                    <child>
                      <object class="GtkLabel" id="free_splits_label">
                        <property name="label" translatable="1">Splits _free</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">split_free_view</property>
                        <property name="halign">start</property>
                        <style><class name="gnc-class-strong"/></style>
                        <layout><property name="column">0</property><property name="row">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="free_splits_scroller">
                        <property name="hexpand">1</property><property name="vexpand">1</property>
                        <property name="child"><object class="GtkColumnView" id="split_free_view"/></property>
                        <layout><property name="column">0</property><property name="row">1</property></layout>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkBox" id="split_lot_side">
                    <property name="orientation">horizontal</property>
                    <child>
                      <object class="GtkBox" id="split_buttons_box">
                        <property name="orientation">vertical</property>
                        <property name="valign">center</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="add_split_to_lot_button">
                            <property name="label">&gt;&gt;</property>
                            <property name="tooltip-text" translatable="1">Add the selected split to the lot</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="remove_split_from_lot_button">
                            <property name="label">&lt;&lt;</property>
                            <property name="tooltip-text" translatable="1">Remove the selected split from the lot</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="in_lot_split_grid">
                        <property name="hexpand">1</property>
                        <property name="margin-top">6</property><property name="margin-bottom">6</property>
                        <property name="margin-start">3</property><property name="margin-end">6</property>
                        <property name="row-spacing">3</property>
                        <child>
                          <object class="GtkLabel" id="in_lot_splits_label">
                            <property name="label" translatable="1">Splits _in lot</property>
                            <property name="use-underline">1</property>
                            <property name="mnemonic-widget">split_in_lot_view</property>
                            <property name="halign">start</property>
                            <style><class name="gnc-class-strong"/></style>
                            <layout><property name="column">0</property><property name="row">0</property></layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow" id="in_lot_splits_scroller">
                            <property name="hexpand">1</property><property name="vexpand">1</property>
                            <property name="child"><object class="GtkColumnView" id="split_in_lot_view"/></property>
                            <layout><property name="column">0</property><property name="row">1</property></layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="show_adjusted_amounts_checkbutton">
            <property name="label" translatable="1">Show stock split adjusted amounts</property>
            <property name="focusable">1</property>
            <property name="halign">start</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="lot_action_bar">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="margin-top">6</property><property name="margin-bottom">6</property>
            <property name="margin-start">6</property><property name="margin-end">6</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="new_lot_button">
                <property name="label" translatable="1">_New Lot</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="scrub_account_button">
                <property name="label" translatable="1">Scrub _Account</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="scrub_lot_button">
                <property name="label" translatable="1">_Scrub</property>
                <property name="use-underline">1</property>
                <property name="sensitive">False</property>
                <property name="tooltip-text" translatable="1">Scrub the highlighted lot</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="delete_button">
                <property name="label" translatable="1">_Delete</property>
                <property name="use-underline">1</property>
                <property name="sensitive">False</property>
                <property name="tooltip-text" translatable="1">Delete the highlighted lot</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="label" translatable="1">_Close</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
